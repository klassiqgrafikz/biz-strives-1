<%- include('layout', { title: 'Savings', userId: userId, body: '' }) %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Savings Pot</h1>
      <p class="text-gray-600 mt-1">Track your accumulated savings</p>
    </div>
    <div class="text-right">
      <div class="bg-white rounded-lg shadow p-4 inline-block">
        <p class="text-sm text-gray-500">Current Balance</p>
        <p class="text-2xl font-bold text-blue-600"><%= fmtNaira(balance) %></p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <button onclick="document.getElementById('addToSavingsModal').classList.remove('hidden')" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">Add to Savings</button>
    <button onclick="document.getElementById('withdrawSavingsModal').classList.remove('hidden')" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">Withdraw</button>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="p-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold">Savings History</h2>
    </div>
    <table class="w-full">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% entries.forEach(e => { %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3"><%= e.saved_at.split('T')[0] %></td>
          <td class="px-4 py-3 <%= e.amount_cents >= 0 ? 'text-green-600' : 'text-red-600' %>">
            <%= e.amount_cents >= 0 ? 'Deposit' : 'Withdrawal' %>
          </td>
          <td class="px-4 py-3"><%= e.description || '-' %></td>
          <td class="px-4 py-3 text-right <%= e.amount_cents >= 0 ? 'text-green-600' : 'text-red-600' %>">
            <%= e.amount_cents >= 0 ? '+' : '' %><%= fmtNaira(Math.abs(e.amount_cents)) %>
          </td>
          <td class="px-4 py-3 text-right">
            <form method="POST" action="/savings/<%= e.id %>/delete" onsubmit="return confirm('Delete this entry?')" class="inline">
              <button type="submit" class="text-red-600 hover:text-red-800 text-sm">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (entries.length === 0) { %>
        <tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">No savings entries yet</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div id="addToSavingsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="p-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Add to Savings</h2>
      <button onclick="document.getElementById('addToSavingsModal').classList.add('hidden')" class="text-gray-500 hover:text-gray-700">×</button>
    </div>
    <form method="POST" action="/savings" class="p-4 space-y-4">
      <input type="hidden" name="action" value="deposit">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Amount (₦) *</label>
        <input type="number" name="amount" step="0.01" min="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <input type="text" name="description" placeholder="e.g., Monthly contribution" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="flex justify-end pt-2">
        <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700">Add to Pot</button>
      </div>
    </form>
  </div>
</div>

<div id="withdrawSavingsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="p-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Withdraw from Savings</h2>
      <button onclick="document.getElementById('withdrawSavingsModal').classList.add('hidden')" class="text-gray-500 hover:text-gray-700">×</button>
    </div>
    <form method="POST" action="/savings" class="p-4 space-y-4">
      <input type="hidden" name="action" value="withdraw">
      <div class="bg-yellow-50 p-3 rounded-md mb-3">
        <p class="text-sm text-yellow-800">Current Balance: <%= fmtNaira(balance) %></p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Amount (₦) *</label>
        <input type="number" name="amount" step="0.01" min="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <input type="text" name="description" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="flex justify-end pt-2">
        <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">Withdraw</button>
      </div>
    </form>
  </div>
</div>