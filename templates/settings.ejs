<%- include('layout', { title: 'Settings', userId: userId, body: '' }) %>
<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-800">Settings</h1>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow">
      <div class="p-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold">Business Info</h2>
      </div>
      <form method="POST" action="/settings" class="p-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Business Name</label>
          <input type="text" name="business_name" value="<%= settings.business_name %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Brand Name (for messages)</label>
          <input type="text" name="brand_name" value="<%= settings.brand_name %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tagline</label>
          <input type="text" name="tagline" value="<%= settings.tagline || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Statement Email</label>
          <input type="email" name="statement_email" value="<%= settings.statement_email || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          <p class="text-xs text-gray-500">Email for monthly statements</p>
        </div>
      </form>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="p-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold">Email (Gmail SMTP)</h2>
      </div>
      <form method="POST" action="/settings" class="p-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Gmail Address</label>
          <input type="email" name="gmail_user" value="<%= settings.gmail_user || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          <p class="text-xs text-gray-500">Used for sending birthday and monthly messages</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Gmail App Password</label>
          <input type="password" name="gmail_app_password" value="" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          <p class="text-xs text-gray-500">Generate at <a href="https://myaccount.google.com/apppasswords" target="_blank" class="text-blue-600 hover:underline">myaccount.google.com/apppasswords</a></p>
        </div>
      </form>
    </div>

    <div class="bg-white rounded-lg shadow lg:col-span-2">
      <div class="p-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold">Automation Schedule</h2>
      </div>
      <form method="POST" action="/settings" class="p-4 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Timezone</label>
            <select name="timezone" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="Africa/Lagos" <%= settings.timezone === 'Africa/Lagos' ? 'selected' : '' %>>Africa/Lagos (Nigeria)</option>
              <option value="America/New_York" <%= settings.timezone === 'America/New_York' ? 'selected' : '' %>>America/New_York (US)</option>
              <option value="Europe/London" <%= settings.timezone === 'Europe/London' ? 'selected' : '' %>>Europe/London (UK)</option>
              <option value="Asia/Tokyo" <%= settings.timezone === 'Asia/Tokyo' ? 'selected' : '' %>>Asia/Tokyo (Japan)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Statement Day of Month</label>
            <input type="number" name="statement_day" min="1" max="28" value="<%= settings.statement_day || 1 %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Statement Time</label>
            <input type="time" name="statement_time" value="<%= settings.statement_time || '21:00' %>" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <p class="text-xs text-gray-500 mt-1">Last day of month at this time</p>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow lg:col-span-2">
    <div class="p-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold">Current Configuration</h2>
    </div>
    <div class="p-4">
      <pre class="text-sm bg-gray-50 p-3 rounded"><code><%= JSON.stringify({ business_name: settings.business_name, brand_name: settings.brand_name, timezone: settings.timezone, statement_time: settings.statement_time, gmail_user: settings.gmail_user ? '✓ configured' : 'not configured' }, null, 2) %></code></pre>
    </div>
  </div>
</div>