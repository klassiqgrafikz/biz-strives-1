<%- include('layout', { title: 'Reports', userId: userId, body: '' }) %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">Monthly Reports</h1>
    <a href="/reports/pdf?month=<%= selectedMonth %>" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">Download PDF Statement</a>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="p-4 border-b border-gray-200">
      <form method="GET" class="flex items-center space-x-4">
        <label class="text-sm font-medium text-gray-700">Select Month:</label>
        <select name="month" onchange="this.form.submit()" class="px-3 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          <% const months = ['January','February','March','April','May','June','July','August','September','October','November','December']; const currentYear = new Date().getFullYear(); for(let y = currentYear; y >= 2020; y--) { for(let m = 11; m >= 0; m--) { const date = new Date(y, m, 1); const value = date.toISOString().slice(0,7); const label = months[m] + ' ' + y; %>
            <option value="<%= value %>" <%= selectedMonth && selectedMonth.startsWith(value) ? 'selected' : '' %>><%= label %></option>
          <% }}} %>
        </select>
      </form>
    </div>

    <div class="p-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h2 class="text-lg font-semibold mb-3">Income Received</h2>
          <p class="text-3xl font-bold text-green-600 mb-2"><%= fmtNaira(incomeTotal) %></p>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-2">Date</th>
                <th class="text-left py-2">Customer</th>
                <th class="text-right py-2">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% payments.slice(0,10).forEach(p => { %>
                <tr class="border-b border-gray-100">
                  <td class="py-2"><%= p.received_at.split('T')[0] %></td>
                  <td class="py-2"><%= p.customer_name %></td>
                  <td class="py-2 text-right text-green-600"><%= fmtNaira(p.amount_cents) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <% if (payments.length > 10) { %>
            <p class="text-xs text-gray-500 mt-2">Showing 10 of <%= payments.length %> payments</p>
          <% } %>
        </div>

        <div>
          <h2 class="text-lg font-semibold mb-3">Spending & Savings</h2>
          <div class="space-y-3">
            <div class="flex justify-between items-center p-3 bg-red-50 rounded">
              <span class="font-medium">Total Expenses</span>
              <span class="text-red-600 font-semibold"><%= fmtNaira(expenseTotal) %></span>
            </div>
            <div class="flex justify-between items-center p-3 bg-yellow-50 rounded">
              <span class="font-medium">Total Savings</span>
              <span class="text-yellow-600 font-semibold"><%= fmtNaira(savingsTotal) %></span>
            </div>
            <div class="flex justify-between items-center p-3 bg-blue-50 rounded border-l-4 border-blue-500">
              <span class="font-medium">Net Cash Flow</span>
              <span class="<%= net >= 0 ? 'text-green-600' : 'text-red-600' %> font-semibold"><%= fmtNaira(net) %></span>
            </div>
          </div>
        </div>
      </div>

      <% if (expenses.length > 0) { %>
      <div class="mt-6">
        <h3 class="text-md font-semibold mb-3">Expenses Detail</h3>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left py-2">Date</th>
              <th class="text-left py-2">Category</th>
              <th class="text-left py-2">Description</th>
              <th class="text-right py-2">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% expenses.forEach(e => { %>
              <tr class="border-b border-gray-100">
                <td class="py-2"><%= e.spent_at.split('T')[0] %></td>
                <td class="py-2"><%= e.category %></td>
                <td class="py-2"><%= e.description || '-' %></td>
                <td class="py-2 text-right"><%= fmtNaira(e.amount_cents) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>

      <% if (savingsEntries.length > 0) { %>
      <div class="mt-6">
        <h3 class="text-md font-semibold mb-3">Savings Detail</h3>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left py-2">Date</th>
              <th class="text-left py-2">Description</th>
              <th class="text-right py-2">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% savingsEntries.forEach(s => { %>
              <tr class="border-b border-gray-100">
                <td class="py-2"><%= s.saved_at.split('T')[0] %></td>
                <td class="py-2"><%= s.description || '-' %></td>
                <td class="py-2 text-right <%= s.amount_cents >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= s.amount_cents >= 0 ? '+' : '' %><%= fmtNaira(Math.abs(s.amount_cents)) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>